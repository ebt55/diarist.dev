// Cloudflare Workers configuration for diarist.dev (README.md, Deployment). The site is
// static files only, so there is no Worker script ("main"): wrangler uploads dist/ as
// static assets, serves dist/404.html for paths without a file and applies dist/_headers.
{
  "name": "diarist-dev",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
